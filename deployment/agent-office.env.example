# /etc/agent-office/agent-office.env  (root:agent-office, mode 0640). install.sh creates it with a random admin token.
AGENTLINK_ADMIN_TOKEN=al_change_me
AGENTLINK_DB_PATH=/var/lib/agent-office/agent-office.db
AGENTLINK_MODE=production
# Optional: the building layout (floors/specializations). Default: built-in five floors.
# AGENTLINK_OFFICE_CONFIG=/etc/agent-office/office.json
# GitHub webhook (optional)
# GITHUB_WEBHOOK_SECRET=
# --- used by the timers, not by the backend ---
AO_URL=http://127.0.0.1:8080
AO_BACKUP_DIR=/var/backups/agent-office
AO_BACKUP_KEEP=14
# Healthchecks.io ping URL (https://hc-ping.com/<uuid>). Empty = local check only.
HC_PING_URL=
